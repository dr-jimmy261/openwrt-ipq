/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-ess.dtsi"
#include "ipq8074-nss.dtsi"
#include "ipq8074-hk-cpu.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Qualcomm Technologies, Inc. IPQ807x/AP-HK09 (Hisense 5G-CPE)";
	compatible = "hisense,5g-cpe", "qcom,ipq807x";

	aliases {
		serial0 = &blsp1_uart5;
		serial1 = &blsp1_uart3;
		led-boot = &led_signal_r;
		led-failsafe = &led_signal_r;
		led-running = &led_signal_g;
		led-upgrade = &led_signal_r;
		ethernet0 = &dp3;
		ethernet1 = &dp4;
		ethernet2 = &dp5;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 55 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_5g: led-5g {
			gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_2g: led-2g {
			gpios = <&tlmm 62 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_signal_r: led-signal-r {
			gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_signal_g: led-signal-g {
			gpios = <&tlmm 63 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

/*&reserved_memory {
	wcnss@4b000000 {
		no-map;
		reg = <0x0 0x4b000000 0x0 0x5f00000>;
	};

	tzapp@4a400000 {
		no-map;
		reg = <0x0 0x4a400000 0x0 0x200000>;
	};

	q6_etr_dump@50f00000 {
		no-map;
		reg = <0x0 0x50f00000 0x0 0x100000>;
	};

	wifi_dump@51000000 {
		no-map;
		reg = <0x0 0x51000000 0x0 0x600000>;
	};

	wigig_dump@51200000 {
		no-map;
		reg = <0x0 0x51200000 0x0 0x400000>;
	};
};*/

&tlmm {
	button_pins: button-pins {
		reset_button {
			pins = "gpio55";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	mdio_pinmux: mdio-pinmux {
		mux_0 {
			pins = "gpio68";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		mux_1 {
			pins = "gpio69";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	led_pins: led-pins {
		led_5g {
			pins = "gpio61";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_2g {
			pins = "gpio62";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_signal_r {
			pins = "gpio2";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_signal_g {
			pins = "gpio63";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	pcie_pins: pcie-pins {
		pcie0_rst {
			pins = "gpio58";
			function = "pcie0_rst";
			drive-strength = <8>;
			bias-pull-down;
		};
		pcie0_wake {
			pins = "gpio59";
			function = "pcie0_wake";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
	
	usb_mux_pins {
		mux {
			pins = "gpio27";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
};

&blsp1_uart5 {
	status = "okay";
};

&blsp1_uart3 {
	status = "okay";
};

&blsp1_spi1 {
	status = "okay";
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	cs-select = <0>;

	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0>;
		compatible = "n25q128a11", "jedec,spi-nor";
		spi-max-frequency = <50000000>;
	};
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <8>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;
	};
};

&blsp1_i2c3 {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&crypto {
	status = "okay";
};

&prng {
	status = "okay";
};

&qusb_phy_0 {
	status = "okay";
};

&qusb_phy_1 {
	status = "okay";
};

&ssphy_0 {
	status = "okay";
};

&ssphy_1 {
	status = "okay";
};

&usb_0 {
	status = "okay";
};

&usb_1 {
	status = "okay";
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pinmux>;
	pinctrl-names = "default";
	reset-gpio = <&tlmm 37 GPIO_ACTIVE_LOW>;

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		qca8075_0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <8>;
		};

		qca8075_1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <9>;
		};
	};

	qca8081: ethernet-phy@4 {
		compatible = "ethernet-phy-id004d.d101";
		reg = <4>;
		reset-deassert-us = <10000>;
		reset-gpio = <&tlmm 44 GPIO_ACTIVE_LOW>;
	};
};

&switch {
	status = "okay";
	switch_lan_bmp = <(ESS_PORT1 | ESS_PORT2)>;
	switch_wan_bmp = <ESS_PORT5>; 
	switch_mac_mode = <MAC_MODE_PSGMII>; 
	switch_mac_mode1 = <MAC_MODE_SGMII_PLUS>;

	qcom,port_phyinfo {
		port@1 {
			port_id = <1>;
			phy_address = <8>;
		};
		port@2 {
			port_id = <2>;
			phy_address = <9>;
		};
		port@5 {
			port_id = <5>;
			phy_address = <4>;
			port_mac_sel = "QGMAC_PORT";
		};
	};
};

&edma {
	status = "okay";
};

&dp1 {
	status = "okay";
	phy-handle = <&qca8075_0>;
	label = "lan1";
};

&dp2 {
	status = "okay";
	phy-handle = <&qca8075_1>;
	label = "lan2";
};

&dp5 {
	status = "okay";
	phy-handle = <&qca8081>;
	label = "wan";
};

&pcie_qmp0 {
	status = "okay";
};

&pcie0 {
	status = "okay";
	pinctrl-0 = <&pcie_pins>;
	pinctrl-names = "default";
	perst-gpio = <&tlmm 58 GPIO_ACTIVE_LOW>;
};

&wifi {
	status = "okay";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,ath11k-calibration-variant = "Hisense_5G_CPE";
};